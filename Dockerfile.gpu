FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu20.04

# 防止交互式安装卡住
ENV DEBIAN_FRONTEND=noninteractive

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    CUDA_VISIBLE_DEVICES=0

# 安装 Python 3.12 和 pip
RUN apt-get update && apt-get install -y \
    software-properties-common \
    curl \
    wget \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.12 \
    python3.12-dev \
    && ln -sf /usr/bin/python3.12 /usr/bin/python \
    && ln -sf /usr/bin/python3.12 /usr/bin/python3 \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgcc-s1 \
    libfontconfig1 \
    libxft2 \
    libmagic1 \
    libmagic-dev \
    && rm -rf /var/lib/apt/lists/*


# 移除可能存在的系统Python包并清理路径
RUN apt-get update && apt-get remove -y \
    python3-urllib3 \
    python3-requests \
    python3-six \
    python3-certifi \
    python3-chardet \
    python3-idna \
    || true \
    && apt-get autoremove -y \
    && rm -rf /usr/lib/python3/dist-packages/urllib3* \
    && rm -rf /usr/lib/python3/dist-packages/requests* \
    && rm -rf /usr/lib/python3/dist-packages/six* \
    && rm -rf /usr/lib/python3/dist-packages/certifi* \
    && rm -rf /usr/lib/python3/dist-packages/chardet* \
    && rm -rf /usr/lib/python3/dist-packages/idna* \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /app

# 升级pip并安装基础包
RUN python -m pip install --upgrade pip
RUN python -m pip install --force-reinstall setuptools wheel six urllib3 requests certifi chardet idna


RUN pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118

# 复制依赖文件
COPY requirements.txt .

# 安装其他依赖
RUN pip install -r requirements.txt

# 复制项目代码
COPY . .

# 创建必要的目录
RUN mkdir -p api/logs apps/reranker/models

# 设置权限
RUN chmod 755 api/logs apps/reranker/models \
    && chmod +x api/run.py

# 暴露端口
EXPOSE 23333

# 健康检查
HEALTHCHECK --interval=180s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:23333/ || exit 1

# 启动命令
CMD ["python", "api/run.py"] 